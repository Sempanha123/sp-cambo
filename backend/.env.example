APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SP_CAMBO_RELEASE=2026.08.29-r20-ui-provider-routing
# Comma-separated fixed proxy IPs/CIDRs only; leave empty for direct local access.
TRUSTED_PROXIES=
SP_CAMBO_API_KEY_LOOKUP_SECRET=
SP_CAMBO_MANAGEMENT_KEY_LOOKUP_SECRET=
SP_CAMBO_REDEEM_CODE_LOOKUP_SECRET=
SP_CAMBO_INTERNAL_GATEWAY_SECRET=
SP_CAMBO_GATEWAY_BASE_URL=http://127.0.0.1:3010
SP_CAMBO_PLAYGROUND_DAILY_TOKEN_QUOTA=20000
SP_CAMBO_PLAYGROUND_TIMEOUT_SECONDS=90
SP_CAMBO_PLAYGROUND_CONNECT_TIMEOUT_SECONDS=30
SP_CAMBO_ALLOW_PRIVATE_PROVIDER_ORIGINS=true
# Holds finite stock for an unpaid checkout before automatically releasing it.
SP_CAMBO_PACKAGE_STOCK_RESERVATION_TTL_SECONDS=900

# Provider origins/credentials are configured only in Admin > Providers.
# They are stored as encrypted database connection revisions and are not read
# from backend .env values.

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3010
CONTROL_PLANE_BASE_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=4096
GATEWAY_UPSTREAM_TIMEOUT_MS=120000
GATEWAY_CONTROL_PLANE_TIMEOUT_MS=5000

KHQR_HOST=127.0.0.1
KHQR_PORT=3011
KHQR_MAX_BODY_BYTES=8192

BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# Legacy single-token setting. It remains the first slot when configured.
BAKONG_TOKEN=
# Comma-separated fallback tokens approved for this deployment by Bakong.
BAKONG_TOKENS=
BAKONG_TOKEN_DAILY_LIMIT=100
BAKONG_QUOTA_TIMEZONE=Asia/Phnom_Penh
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY=USD
BAKONG_PAYMENT_ATTEMPT_TTL_SECONDS=300
BAKONG_RECONCILE_INTERVAL_SECONDS=300
BAKONG_CUSTOMER_AUTO_CHECK_INTERVAL_SECONDS=120
BAKONG_RECONCILE_EXPIRED_GRACE_SECONDS=900
BAKONG_VERIFICATION_LEASE_SECONDS=90
BAKONG_KHQR_GENERATOR_URL=http://127.0.0.1:3011/v1/khqr/generate
BAKONG_KHQR_GENERATOR_SECRET=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sp_cambo
DB_USERNAME=root
DB_PASSWORD=
# Needed only where MySQL defaults to MyISAM or has legacy index limits.
DB_ENGINE="InnoDB ROW_FORMAT=DYNAMIC"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host[:port] values only. Production example: app.spcambo.com
# In browser cookie mode, use one hostname consistently; do not mix localhost
# with 127.0.0.1 because XSRF/session cookies are host-scoped.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
# Exact browser origins with scheme. Never use * with credentialed CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Telegram Store Bot — ONE customer-facing bot only (server-side only)
# Website checkout never sends Telegram order/admin/public-channel alerts.
# Create the bot in BotFather, then register this bot's webhook from your
# deployment/admin workflow. All menus/product/Buy Now buttons are
# generated by SP Cambo; do not build the store buttons manually in BotFather.
TELEGRAM_STOREFRONT_BOT_TOKEN=
TELEGRAM_STOREFRONT_BOT_USERNAME=
TELEGRAM_STOREFRONT_WEBHOOK_SECRET=
TELEGRAM_STOREFRONT_LINK_SECRET=
# Optional support button, e.g. https://t.me/your_support
TELEGRAM_STOREFRONT_SUPPORT_URL=

TELEGRAM_HTTP_TIMEOUT_SECONDS=15
TELEGRAM_DELIVERY_LEASE_SECONDS=120
TELEGRAM_ANNOUNCEMENT_LEASE_SECONDS=120
TELEGRAM_ANNOUNCEMENT_MAX_ATTEMPTS=8

# Subscriber storefront activity. Only paid + fulfilled + delivered purchases
# that originated inside the Telegram Store can create NEW ORDER activity.
TELEGRAM_STOREFRONT_PURCHASE_ACTIVITY_ENABLED=true
TELEGRAM_STOREFRONT_PURCHASE_ACTIVITY_MIN_DELAY_SECONDS=5
TELEGRAM_STOREFRONT_PURCHASE_ACTIVITY_MAX_PER_HOUR=30
# Optional language-specific templates. Leave blank to use SP Cambo defaults.
TELEGRAM_STOREFRONT_PURCHASE_TEMPLATE_EN=
TELEGRAM_STOREFRONT_PURCHASE_TEMPLATE_KM=

# Legacy Store Bot variable names are still accepted during upgrades.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_LINK_SECRET=

SP_CAMBO_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:3010

# Registration email verification (example: Gmail SMTP with a Google App Password)
# Keep secrets only in backend/.env. Never commit the App Password.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-sender@gmail.com
# MAIL_PASSWORD=your-16-character-google-app-password
# MAIL_FROM_ADDRESS=your-sender@gmail.com
# MAIL_FROM_NAME="SP Cambo"
