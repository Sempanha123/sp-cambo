APP_NAME="SP Cambo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.spcambo.com
FRONTEND_URL=https://app.spcambo.com
# Laravel trusts forwarding headers only from this fixed Compose Nginx address.
# Keep infra/compose.yaml control network aligned; never use '*' in production.
TRUSTED_PROXIES=172.29.0.10
NUXT_PUBLIC_SESSION_MODE=cookie
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sp_cambo
DB_USERNAME=sp_cambo
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=sp_cambo_session
SESSION_DOMAIN=.spcambo.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.spcambo.com
CORS_ALLOWED_ORIGINS=https://app.spcambo.com
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

SP_CAMBO_API_KEY_LOOKUP_SECRET=
SP_CAMBO_MANAGEMENT_KEY_LOOKUP_SECRET=
SP_CAMBO_INTERNAL_GATEWAY_SECRET=

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3010
CONTROL_PLANE_BASE_URL=http://nginx:8081
GATEWAY_MAX_BODY_BYTES=1048576
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS=4096
GATEWAY_UPSTREAM_TIMEOUT_MS=120000
GATEWAY_CONTROL_PLANE_TIMEOUT_MS=5000

OMNIROUTE_IMAGE=
OMNIROUTE_BASE_URL=http://omniroute:20128
OMNIROUTE_API_KEY=
OMNIROUTE_VERSION=3.8.49

BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY=USD
BAKONG_PAYMENT_ATTEMPT_TTL_SECONDS=300
BAKONG_RECONCILE_INTERVAL_SECONDS=60
BAKONG_CUSTOMER_AUTO_CHECK_INTERVAL_SECONDS=15
BAKONG_RECONCILE_EXPIRED_GRACE_SECONDS=900
BAKONG_KHQR_GENERATOR_URL=http://khqr:3011/v1/khqr/generate
BAKONG_KHQR_GENERATOR_SECRET=
KHQR_HOST=0.0.0.0
KHQR_PORT=3011

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

NUXT_PUBLIC_API_BASE_URL=https://api.spcambo.com/api/v1
# Gateway ROOT, not the OpenAI base: Anthropic clients append /v1/messages.
# The name must match Nuxt's runtimeConfig.public.inferenceRootUrl exactly.
NUXT_PUBLIC_INFERENCE_ROOT_URL=https://api.spcambo.com
NUXT_PUBLIC_SITE_URL=https://spcambo.com
# Optional support channel. An email address or an http(s) URL. Left blank on
# purpose: a suspended account, a payment that failed verification and a suspended
# managed customer all tell the reader to contact SP Cambo, and they show a link only
# once a real channel is published here. No address is guessed when it is blank, and
# a value that is neither an address nor an http(s) URL fails the frontend build.
NUXT_PUBLIC_SUPPORT_URL=
# Server-only SSR origin for public pages. Never exposed to the browser.
NUXT_INTERNAL_API_BASE_URL=http://nginx/api/v1

# Telegram storefront bot username without @
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=
