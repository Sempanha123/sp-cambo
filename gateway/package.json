{
  "name": "@sp-cambo/inference-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "khqr": "tsx src/khqr-server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preinstall": "node scripts/enforce-pnpm.cjs"
  },
  "dependencies": {
    "bakong-khqr": "1.0.20",
    "fastify": "5.12.1",
    "ioredis": "5.8.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
