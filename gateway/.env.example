# Public inference gateway (local development)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3010
CONTROL_PLANE_BASE_URL=http://127.0.0.1:8001

# Windows local development uses a second Laravel process on :8001 for
# Gateway callbacks. This avoids Laravel(:8000) -> Gateway -> Laravel(:8000)
# deadlock under the single-process PHP CLI server.

# Must match backend/.env. The installer can generate/sync this automatically.
SP_CAMBO_INTERNAL_GATEWAY_SECRET=

# Local development can run without Redis. Use redis in production/multi-instance.
GATEWAY_RATE_STORE=memory
REDIS_URL=redis://127.0.0.1:6379

# OmniRoute/provider credentials are intentionally NOT required here.
# Laravel returns the selected admin connection revision privately per preflight.

# KHQR private sidecar
KHQR_HOST=127.0.0.1
KHQR_PORT=3011
BAKONG_KHQR_GENERATOR_SECRET=
