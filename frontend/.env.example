# Public browser endpoints only. Never place secrets here.
# Keep the frontend and Laravel hostnames identical in cookie mode: do not mix
# localhost and 127.0.0.1, because browser cookies are host-scoped.
#
# Each NUXT_PUBLIC_* name must match its runtime-config property exactly. Nuxt
# ignores a near-miss without warning and keeps the development default, which
# would ship a loopback address inside customer CLI setup instructions.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Customer-facing inference gateway ROOT. Must not end in /v1: Claude Code and
# the Anthropic SDKs append /v1/messages themselves. The OpenAI-compatible base
# advertised to Codex CLI is derived from this by appending /v1.
NUXT_PUBLIC_INFERENCE_ROOT_URL=http://127.0.0.1:3010

# Canonical public origin, used for server-rendered canonical links.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

NUXT_PUBLIC_SESSION_MODE=bearer

# Optional. Where a customer reaches a human: an email address, a mailto: or an
# http(s) URL (a help desk, or a chat handle such as https://t.me/...). Several
# surfaces tell a suspended account or a failed payment to contact SP Cambo, and
# they only show a link when this is set — nothing is invented when it is not.
# Anything that is neither an address nor an http(s) URL fails a strict build
# rather than silently showing no link.
# NUXT_PUBLIC_SUPPORT_URL=

# Server-only control-plane origin used during SSR of public pages. Not exposed to
# the browser. Set this in a deployment where the frontend container cannot reach
# its own public hostname (public DNS/TLS/NAT hairpin from inside the private
# network), e.g. http://nginx/api/v1. Leave unset locally.
# NUXT_INTERNAL_API_BASE_URL=
